@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_MessageLayoutStyleComponentPartial")

<body class="preload"
      data-title="@ViewData["Title"]"
      data-active-menu="@ViewData["ActiveMenu"]"
      data-toast-success="@TempData["Success"]"
      data-toast-error="@TempData["Error"]">

    @await Component.InvokeAsync("_MessageLayoutSidebarComponentPartial")

    @await Component.InvokeAsync("_MessageLayoutNavbarComponentPartial")

    <main class="app-main page-enter" id="mainContent">
        @RenderBody()
    </main>

    <div class="toast-stack" id="toastStack"></div>

    @await Component.InvokeAsync("_MessageLayoutScriptComponentPartial")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
