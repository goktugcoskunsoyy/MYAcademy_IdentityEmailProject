@model ForgetPasswordViewModel
@{
    Layout = null;
    bool isSent = ViewBag.IsSent ?? false;
    var errors = ViewData.ModelState.Values.SelectMany(x => x.Errors).Select(x => x.ErrorMessage).ToList();
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_LoginStyleComponentPartial")

<body>

    <div class="auth-bg" aria-hidden="true"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>

    <main class="auth-page">
        <div class="auth-card">
            @await Component.InvokeAsync("_LoginBrandComponentPartial")

            <section class="auth-form-wrap" id="formWrap">
                @if (isSent)
                {
                    <div class="success-view">
                        <div class="success-ic"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M13 25l7 7 15-16" /></svg></div>
                        <h2>E-postanızı kontrol edin</h2>
                        <p><b>@Model.Email</b> bir hesapla eşleşiyorsa, şifre yenileme bağlantısı birkaç dakika içinde gelen kutunuza ulaşacak. Bağlantı 30 dakika geçerlidir ve yalnızca bir kez kullanılabilir.</p>
                        <a class="btn-primary-x" style="margin-top:0;text-decoration:none" asp-controller="Login" asp-action="SignIn"><span class="lbl">Giriş Sayfasına Dön</span><i class="bi bi-arrow-right"></i></a>
                        <a class="btn-ghost" style="width:100%;margin-top:10px;text-decoration:none" asp-controller="PasswordChange" asp-action="ForgetPassword"><i class="bi bi-arrow-repeat"></i> Farklı bir adres dene</a>
                    </div>
                }
                else
                {
                    <div class="form-head">
                        <h1>Şifremi Unuttum</h1>
                        <p>Hesabınıza kayıtlı e-posta adresini girin, size tek kullanımlık bir şifre yenileme bağlantısı gönderelim.</p>
                        <div class="switch-link">Şifrenizi hatırladınız mı? <a asp-controller="Login" asp-action="SignIn">Giriş Yap</a></div>
                    </div>

                    <form method="post" id="forgetForm" asp-controller="PasswordChange" asp-action="ForgetPassword" novalidate>
                        @if (errors.Any())
                        {
                            <div class="form-alert" role="alert"><i class="bi bi-exclamation-octagon-fill"></i><span><b>İşlem başarısız</b>@(string.Join(" ", errors))</span></div>
                        }

                        <div class="form-grid">
                            <div class="field" data-field="email">
                                <label for="email">Email <span class="req">*</span></label>
                                <div class="input-wrap">
                                    <i class="bi bi-envelope lead"></i>
                                    <input class="a-input" id="email" asp-for="Email" type="email" placeholder="ad.soyad@ornek.com" autocomplete="email" spellcheck="false" autocapitalize="none" required>
                                    <i class="bi bi-exclamation-circle-fill state err"></i>
                                </div>
                                <div class="hint">Hesabınıza kayıtlı e-posta adresini girin.</div>
                                <div class="msg" aria-live="polite"></div>
                            </div>
                        </div>

                        <button type="submit" class="btn-primary-x" id="submitBtn">
                            <span class="lbl">Bağlantı Gönder</span><i class="bi bi-send"></i>
                        </button>

                        <div class="secure-note"><i class="bi bi-shield-check"></i> Bağlantı 30 dakika geçerlidir ve tek kullanımlıktır.</div>
                        <div class="form-foot">Hesabınız yok mu? <a asp-controller="Register" asp-action="SignUp">Kayıt Ol</a></div>
                    </form>
                }
            </section>
        </div>
    </main>

    <script>
        document.title = 'Şifremi Unuttum · Mailora';
        const forgetForm = document.getElementById('forgetForm');
        if (forgetForm) {
            forgetForm.addEventListener('submit', e => {
                const input = document.getElementById('email');
                const field = input.closest('.field');
                const v = input.value.trim();
                const ok = /^[^\s@@<>()[\],;:"]+@@[^\s@@<>()[\],;:"]+\.[a-z]{2,}$/i.test(v);
                field.classList.toggle('is-invalid', !ok);
                field.querySelector('.msg').textContent = ok ? '' : (v ? 'Geçerli bir email adresi girin (ör. ad@ornek.com).' : 'Email alanı zorunludur.');
                if (!ok) { e.preventDefault(); input.focus(); return; }
                const btn = document.getElementById('submitBtn');
                setTimeout(() => { btn.disabled = true; btn.innerHTML = '<span class="spinner-sm"></span><span class="lbl">Gönderiliyor…</span>'; });
            });
        }
    </script>
</body>
</html>
