@model ResetPasswordViewModel
@{
    Layout = null;
    bool isInvalid = ViewBag.IsInvalid ?? false;
    var errors = ViewData.ModelState.Values.SelectMany(x => x.Errors).Select(x => x.ErrorMessage).ToList();
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_LoginStyleComponentPartial")

<body>

    <div class="auth-bg" aria-hidden="true"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>

    <main class="auth-page">
        <div class="auth-card">
            @await Component.InvokeAsync("_LoginBrandComponentPartial")

            <section class="auth-form-wrap" id="formWrap">
                @if (isInvalid || Model == null)
                {
                    <div class="success-view">
                        <div class="success-ic" style="background:var(--rose)"><i class="bi bi-link-45deg" style="font-size:42px;color:var(--danger)"></i></div>
                        <h2>Bağlantı geçersiz</h2>
                        <p>Bu şifre yenileme bağlantısının süresi dolmuş, daha önce kullanılmış ya da bağlantı hatalı. Güvenliğiniz için lütfen yeni bir bağlantı isteyin.</p>
                        <a class="btn-primary-x" style="margin-top:0;text-decoration:none" asp-controller="PasswordChange" asp-action="ForgetPassword"><span class="lbl">Yeni Bağlantı İste</span><i class="bi bi-send"></i></a>
                        <a class="btn-ghost" style="width:100%;margin-top:10px;text-decoration:none" asp-controller="Login" asp-action="SignIn"><i class="bi bi-arrow-left"></i> Giriş sayfasına dön</a>
                    </div>
                }
                else
                {
                    <div class="form-head">
                        <h1>Yeni Şifre Belirle</h1>
                        <p>Hesabınız için yeni bir şifre belirleyin. Bu bağlantı yalnızca bir kez kullanılabilir.</p>
                    </div>

                    <form method="post" id="resetPasswordForm" asp-controller="PasswordChange" asp-action="ResetPassword" novalidate>
                        <input type="hidden" asp-for="UserId">
                        <input type="hidden" asp-for="Token">
                        @if (errors.Any())
                        {
                            <div class="form-alert" role="alert"><i class="bi bi-exclamation-octagon-fill"></i><span><b>Şifre güncellenemedi</b>@(string.Join(" ", errors))</span></div>
                        }

                        <div class="form-grid">
                            <div class="field" data-field="password">
                                <label for="password">Yeni Şifre <span class="req">*</span></label>
                                <div class="input-wrap">
                                    <i class="bi bi-lock lead"></i>
                                    <input class="a-input has-eye" id="password" asp-for="Password" type="password" placeholder="Yeni şifrenizi girin" autocomplete="new-password" required>
                                    <i class="bi bi-exclamation-circle-fill state err"></i>
                                    <button type="button" class="eye-btn" data-eye="password" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                                </div>
                                <div class="hint">En az 6 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</div>
                                <div class="msg" aria-live="polite"></div>
                            </div>

                            <div class="field" data-field="passwordConfirm">
                                <label for="passwordConfirm">Yeni Şifre Tekrar <span class="req">*</span></label>
                                <div class="input-wrap">
                                    <i class="bi bi-shield-lock lead"></i>
                                    <input class="a-input has-eye" id="passwordConfirm" asp-for="PasswordConfirm" type="password" placeholder="Yeni şifrenizi tekrar girin" autocomplete="new-password" required>
                                    <i class="bi bi-exclamation-circle-fill state err"></i>
                                    <button type="button" class="eye-btn" data-eye="passwordConfirm" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                                </div>
                                <div class="msg" aria-live="polite"></div>
                            </div>
                        </div>

                        <button type="submit" class="btn-primary-x" id="submitBtn">
                            <span class="lbl">Şifremi Güncelle</span><i class="bi bi-arrow-right"></i>
                        </button>

                        <div class="secure-note"><i class="bi bi-shield-check"></i> Şifreniz güvenli şekilde güncellenir.</div>
                        <div class="form-foot">Vazgeçtiniz mi? <a asp-controller="Login" asp-action="SignIn">Giriş Yap</a></div>
                    </form>
                }
            </section>
        </div>
    </main>

    <script>
        document.title = 'Şifre Yenileme · Mailora';
        document.querySelectorAll('[data-eye]').forEach(btn => btn.addEventListener('click', () => {
            const input = document.getElementById(btn.dataset.eye), show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        }));

        const resetPasswordForm = document.getElementById('resetPasswordForm');
        if (resetPasswordForm) {
            resetPasswordForm.addEventListener('submit', e => {
                const password = document.getElementById('password'), confirm = document.getElementById('passwordConfirm');
                const rules = [v => v.length >= 6, v => /[A-ZÇĞİÖŞÜ]/.test(v), v => /[a-zçğıöşü]/.test(v), v => /\d/.test(v), v => /[^A-Za-z0-9ÇĞİÖŞÜçğıöşü\s]/.test(v)];
                const passwordError = !password.value ? 'Şifre alanı zorunludur.' : rules.every(r => r(password.value)) ? '' : 'Şifre tüm kuralları karşılamalıdır.';
                const confirmError = !confirm.value ? 'Şifre tekrarı zorunludur.' : confirm.value !== password.value ? 'Şifreler eşleşmiyor.' : '';
                [[password, passwordError], [confirm, confirmError]].forEach(([input, err]) => {
                    const field = input.closest('.field');
                    field.classList.toggle('is-invalid', !!err);
                    field.querySelector('.msg').textContent = err;
                });
                if (passwordError || confirmError) { e.preventDefault(); (passwordError ? password : confirm).focus(); return; }
                const btn = document.getElementById('submitBtn');
                setTimeout(() => { btn.disabled = true; btn.innerHTML = '<span class="spinner-sm"></span><span class="lbl">Güncelleniyor…</span>'; });
            });
        }
    </script>
</body>
</html>
