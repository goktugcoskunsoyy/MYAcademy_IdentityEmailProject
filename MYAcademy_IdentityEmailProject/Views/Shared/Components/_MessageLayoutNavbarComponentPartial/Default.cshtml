@model AppUser
@{
    var nameSurname = Model.Name + " " + Model.Surname;
    var notifications = ViewBag.Notifications as List<Message> ?? new List<Message>();
    int notificationCount = ViewBag.NotificationCount;
}

<header class="app-navbar">
    <button class="nav-toggle" id="sidebarToggle" type="button" aria-label="Menüyü daralt / genişlet" title="Menüyü daralt"><i class="bi bi-list"></i></button>

    <form class="global-search" method="get" asp-controller="Message" asp-action="Inbox">
        <i class="bi bi-search"></i>
        <input type="search" id="globalSearch" name="search" placeholder="Mesajlarda, kişilerde ara…" autocomplete="off">
        <span class="kbd">Ctrl K</span>
    </form>

    <div class="nav-actions">
        <div class="dropdown">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Bildirimler">
                <i class="bi bi-bell"></i>
                @if (notificationCount > 0)
                {
                    <span class="pip"></span>
                }
            </button>
            <div class="dropdown-menu dropdown-menu-end notif-menu">
                <div class="d-flex justify-content-between align-items-center px-2 pt-1 pb-2">
                    <strong style="font-size:14px">Bildirimler</strong>
                    <span class="tag tag-is">@notificationCount yeni</span>
                </div>
                @if (notifications.Any())
                {
                    foreach (var item in notifications)
                    {
                        <a class="notif-item" asp-controller="Message" asp-action="MessageDetail" asp-route-id="@item.MessageId" style="color:inherit">
                            <div class="ni av-lav"><i class="bi bi-envelope"></i></div>
                            <div style="min-width:0">
                                <div class="nt text-truncate">@item.SenderEmail size mesaj gönderdi</div>
                                <div class="nd text-truncate">@item.Subject · @MessageHelper.ShortTime(item.SendDate)</div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="notif-item">
                        <div class="ni av-mint"><i class="bi bi-check2-all"></i></div>
                        <div><div class="nt">Yeni bildiriminiz yok</div><div class="nd">Tüm mesajlarınızı okudunuz</div></div>
                    </div>
                }
            </div>
        </div>

        <div class="dropdown">
            <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar sm av-user">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@nameSurname">
                    }
                    else
                    {
                        @MessageHelper.Initials(nameSurname)
                    }
                </span>
                <span class="meta">
                    <span class="name d-block">@nameSurname</span>
                    <span class="role d-block">@("@" + Model.UserName)</span>
                </span>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li class="dd-head">
                    <span class="avatar av-user">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@nameSurname">
                        }
                        else
                        {
                            @MessageHelper.Initials(nameSurname)
                        }
                    </span>
                    <div style="min-width:0">
                        <div style="font-weight:700">@nameSurname</div>
                        <div style="font-size:12.5px;color:var(--muted)">@Model.Email</div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Profilim</a></li>
                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" asp-controller="Login" asp-action="LogOut">
                        <button type="submit" class="dropdown-item danger"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
