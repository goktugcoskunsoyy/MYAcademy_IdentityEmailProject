<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
<script>
    (() => {
        const SIDEBAR_KEY = 'mailora.sidebarCollapsed';
        const PER_PAGE = 10;
        const body = document.body;

        const $ = (sel, root = document) => root.querySelector(sel);
        const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];
        const readJSON = k => { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } };
        const writeJSON = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } };
        const escapeHtml = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        function showToast(text, icon = 'bi-check2-circle') {
            const stack = $('#toastStack');
            if (!stack) return;
            const el = document.createElement('div');
            el.className = 'm-toast';
            el.innerHTML = `<i class="bi ${icon} lead-ic"></i><span>${escapeHtml(text)}</span>`;
            stack.appendChild(el);
            setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 250); }, 3200);
        }

        function renderHtml(target, html) {
            if (!target) return;
            if (window.DOMPurify) {
                target.innerHTML = DOMPurify.sanitize(html || '');
                $$('a', target).forEach(a => { a.target = '_blank'; a.rel = 'noopener noreferrer'; });
            } else {
                target.textContent = (html || '').replace(/<[^>]+>/g, ' ');
            }
        }

        if (body.dataset.title) document.title = `${body.dataset.title} · Mailora`;
        const activeMenu = body.dataset.activeMenu;
        if (activeMenu) {
            $$('.side-link').forEach(a => a.classList.toggle('active', a.dataset.page === activeMenu));
        }

        const openSidebar = () => body.classList.add('sidebar-open');
        const closeSidebar = () => body.classList.remove('sidebar-open');

        function setSidebarCollapsed(on, persist = true) {
            body.classList.toggle('sidebar-collapsed', on);
            const t = $('#sidebarToggle');
            if (t) {
                t.title = on ? 'Menüyü genişlet' : 'Menüyü daralt';
                t.setAttribute('aria-expanded', String(!on));
            }
            if (persist) writeJSON(SIDEBAR_KEY, on);
        }

        $('#sidebarToggle')?.addEventListener('click', () => {
            if (window.innerWidth >= 992) setSidebarCollapsed(!body.classList.contains('sidebar-collapsed'));
            else openSidebar();
        });
        $('#sidebarBackdrop')?.addEventListener('click', closeSidebar);
        window.addEventListener('resize', () => { if (window.innerWidth >= 992) closeSidebar(); });

        const globalSearch = $('#globalSearch');
        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); globalSearch?.focus(); }
            if (e.key === 'Escape') closeSidebar();
        });

        document.addEventListener('click', e => {
            const btn = e.target.closest('[data-confirm]');
            if (btn && !confirm(btn.dataset.confirm)) { e.preventDefault(); e.stopPropagation(); }
        }, true);

        $$('[data-copy]').forEach(b => b.addEventListener('click', () => {
            const text = b.dataset.copy;
            const done = () => showToast(`${text} kopyalandı.`, 'bi-clipboard-check');
            if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, () => showToast(text, 'bi-envelope'));
            else showToast(text, 'bi-envelope');
        }));

        $$('[data-print]').forEach(b => b.addEventListener('click', () => window.print()));

        $$('[data-html]').forEach(el => renderHtml(el, el.dataset.html));

        function initMessageList() {
            const list = $('#msgList');
            if (!list) return;

            const rows = $$('.msg-item', list);
            const checkAll = $('#checkAll');
            const selInfo = $('#selInfo');
            const pager = $('#pager');
            const range = $('#rangeInfo');
            const isChecked = r => !!$('.row-check', r)?.checked;
            let page = 1;

            const openRow = row => { if (row.dataset.href) location.href = row.dataset.href; };

            list.addEventListener('click', e => {
                const row = e.target.closest('.msg-item');
                if (!row || e.target.closest('input, button, a, label')) return;
                openRow(row);
            });

            list.addEventListener('keydown', e => {
                const row = e.target.closest('.msg-item');
                if (row && e.key === 'Enter' && !e.target.closest('input, button, a')) openRow(row);
            });

            function updateBulk() {
                const checked = rows.filter(isChecked);
                const visible = rows.filter(r => !r.hidden);
                const visibleChecked = visible.filter(isChecked);
                rows.forEach(r => r.classList.toggle('checked', isChecked(r)));
                if (checkAll) {
                    checkAll.checked = visible.length > 0 && visibleChecked.length === visible.length;
                    checkAll.indeterminate = visibleChecked.length > 0 && visibleChecked.length < visible.length;
                }
                if (selInfo) selInfo.textContent = checked.length ? `${checked.length} mesaj seçildi` : 'Tümünü seç';
                $$('[data-bulk]').forEach(b => { b.disabled = !checked.length; });
            }

            list.addEventListener('change', e => { if (e.target.classList.contains('row-check')) updateBulk(); });

            checkAll?.addEventListener('change', () => {
                rows.filter(r => !r.hidden).forEach(r => { const c = $('.row-check', r); if (c) c.checked = checkAll.checked; });
                updateBulk();
            });

            function renderPage() {
                const count = Math.max(1, Math.ceil(rows.length / PER_PAGE));
                page = Math.min(Math.max(1, page), count);
                rows.forEach((r, i) => { r.hidden = i < (page - 1) * PER_PAGE || i >= page * PER_PAGE; });

                if (range) {
                    const start = rows.length ? (page - 1) * PER_PAGE + 1 : 0;
                    range.textContent = `${start}-${Math.min(page * PER_PAGE, rows.length)} / ${rows.length} mesaj`;
                }

                if (pager) {
                    let html = `<button type="button" data-p="prev" ${page === 1 ? 'disabled' : ''} aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>`;
                    for (let i = 1; i <= count; i++) html += `<button type="button" data-p="${i}" class="${i === page ? 'active' : ''}">${i}</button>`;
                    html += `<button type="button" data-p="next" ${page === count ? 'disabled' : ''} aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>`;
                    pager.innerHTML = html;
                }

                updateBulk();
            }

            pager?.addEventListener('click', e => {
                const b = e.target.closest('button[data-p]');
                if (!b || b.disabled) return;
                page = b.dataset.p === 'prev' ? page - 1 : b.dataset.p === 'next' ? page + 1 : +b.dataset.p;
                renderPage();
                list.scrollTop = 0;
            });

            renderPage();
        }

        initMessageList();

        window.Mailora = { $, $$, escapeHtml, showToast, renderHtml, openSidebar, closeSidebar };

        if (body.dataset.toastSuccess) showToast(body.dataset.toastSuccess, 'bi-check2-circle');
        if (body.dataset.toastError) showToast(body.dataset.toastError, 'bi-exclamation-circle');

        setSidebarCollapsed(readJSON(SIDEBAR_KEY) === true, false);
        requestAnimationFrame(() => requestAnimationFrame(() => body.classList.remove('preload')));
    })();
</script>
