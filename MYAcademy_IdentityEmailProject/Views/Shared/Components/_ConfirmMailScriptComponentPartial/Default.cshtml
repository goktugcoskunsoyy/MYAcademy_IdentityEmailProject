<script>
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];

    const CODE_LENGTH = 6;
    const RESEND_COOLDOWN = 60;

    function toast(title, text, icon = 'bi-check2-circle', type = '') {
        const el = document.createElement('div');
        el.className = `m-toast ${type}`;
        const ti = document.createElement('span');
        ti.className = 'ti';
        ti.innerHTML = `<i class="bi ${icon}"></i>`;
        const body = document.createElement('span');
        const b = document.createElement('b');
        b.textContent = title;
        body.appendChild(b);
        body.appendChild(document.createTextNode(text));
        el.appendChild(ti);
        el.appendChild(body);
        $('#toastStack').appendChild(el);
        setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 250); }, 3600);
    }

    if (document.body.dataset.toastSuccess) toast('Kod gönderildi', document.body.dataset.toastSuccess, 'bi-envelope-check');
    if (document.body.dataset.toastError) toast('Doğrulama gerekli', document.body.dataset.toastError, 'bi-shield-exclamation', 'error');

    const redirectNote = $('#redirectNote');
    if (redirectNote) {
        let s = 5;
        const id = setInterval(() => {
            s--;
            redirectNote.textContent = `${s} saniye içinde giriş sayfasına yönlendirileceksiniz.`;
            if (s <= 0) { clearInterval(id); location.href = redirectNote.dataset.redirect; }
        }, 1000);
    }

    const form = $('#verifyForm');
    if (form) {
        const otp = $('#otp');
        const boxes = $$('input', otp);
        const msg = $('#msg');
        const btn = $('#verifyBtn');
        let submitting = false;

        const getCode = () => boxes.map(b => b.value).join('');

        function setError(text) {
            otp.classList.remove('is-valid');
            otp.classList.toggle('is-invalid', !!text);
            msg.className = 'msg' + (text ? ' err' : '');
            msg.textContent = text || '';
            if (text) { otp.classList.remove('shake'); void otp.offsetWidth; otp.classList.add('shake'); }
        }

        function refresh() {
            boxes.forEach(b => b.classList.toggle('filled', !!b.value));
            const code = getCode();
            $('#codeField').value = code;
            btn.disabled = code.length !== CODE_LENGTH;
        }

        function fillFrom(index, digits) {
            digits.slice(0, CODE_LENGTH - index).split('').forEach((d, i) => { boxes[index + i].value = d; });
            const next = Math.min(index + digits.length, CODE_LENGTH - 1);
            boxes[next].focus();
            refresh();
            if (getCode().length === CODE_LENGTH) form.requestSubmit();
        }

        boxes.forEach((box, i) => {
            box.addEventListener('focus', () => box.select());

            box.addEventListener('input', () => {
                const digits = box.value.replace(/\D/g, '');
                box.value = '';
                if (otp.classList.contains('is-invalid')) setError('');
                if (!digits) { refresh(); return; }
                fillFrom(i, digits);
            });

            box.addEventListener('keydown', e => {
                if (e.key === 'Backspace') {
                    if (!box.value && i > 0) { e.preventDefault(); boxes[i - 1].value = ''; boxes[i - 1].focus(); refresh(); }
                    setTimeout(refresh);
                }
                if (e.key === 'ArrowLeft' && i > 0) { e.preventDefault(); boxes[i - 1].focus(); }
                if (e.key === 'ArrowRight' && i < CODE_LENGTH - 1) { e.preventDefault(); boxes[i + 1].focus(); }
                if (e.key === 'Enter') { e.preventDefault(); form.requestSubmit(); }
                if (e.key.length === 1 && !/\d/.test(e.key) && !e.ctrlKey && !e.metaKey) e.preventDefault();
            });

            box.addEventListener('paste', e => {
                e.preventDefault();
                const digits = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                if (!digits) { setError('Panodaki metinde rakam bulunamadı.'); return; }
                setError('');
                fillFrom(digits.length >= CODE_LENGTH ? 0 : i, digits);
            });
        });

        form.addEventListener('submit', e => {
            if (submitting) { e.preventDefault(); return; }
            const code = getCode();
            if (code.length !== CODE_LENGTH) {
                e.preventDefault();
                setError(`Lütfen ${CODE_LENGTH} haneli kodun tamamını girin.`);
                const firstEmpty = boxes.find(b => !b.value);
                if (firstEmpty) firstEmpty.focus();
                return;
            }
            $('#codeField').value = code;
            submitting = true;
            setTimeout(() => {
                btn.disabled = true;
                btn.classList.add('loading');
                btn.innerHTML = '<span class="spinner-sm"></span><span>Doğrulanıyor…</span>';
                boxes.forEach(b => { b.readOnly = true; });
            });
        });

        const resendBtn = $('#resendBtn');
        const resendCd = $('#resendCd');
        const fmt = s => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
        let cooldown = +(document.body.dataset.cooldown || 0);

        function tickCooldown() {
            if (cooldown <= 0) { resendBtn.disabled = false; resendCd.textContent = ''; return false; }
            resendBtn.disabled = true;
            resendCd.textContent = `(${fmt(cooldown)})`;
            cooldown--;
            return true;
        }
        if (tickCooldown()) {
            const cdId = setInterval(() => { if (!tickCooldown()) clearInterval(cdId); }, 1000);
        }

        $('#resendForm').addEventListener('submit', () => {
            setTimeout(() => { resendBtn.disabled = true; resendBtn.textContent = 'Gönderiliyor…'; });
        });

        refresh();
        if (window.innerWidth >= 576) boxes[0].focus();
    }
</script>
