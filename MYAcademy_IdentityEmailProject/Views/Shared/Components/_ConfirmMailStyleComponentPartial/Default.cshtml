<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>E-posta Doğrulama · Mailora</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #F8F9FD;
      --card: #FFFFFF;
      --accent: #8B7FD6;
      --accent-dark: #7467C7;
      --lavender: #EAE6FA;
      --blue: #E8F2FF;
      --mint: #E3F5EE;
      --peach: #FDEEE6;
      --rose: #FBE7EE;
      --text: #303348;
      --muted: #85899B;
      --border: #ECEBF5;
      --success: #3E9A77;
      --success-soft: #5CC09A;
      --danger: #C2476B;
      --shadow-lg: 0 24px 60px rgba(91, 80, 170, .16);
      --ease: cubic-bezier(.4, 0, .2, 1);
    }

    * { box-sizing: border-box; }
    html, body { min-height: 100%; }
    body {
      margin: 0;
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      background: var(--bg); color: var(--text); font-size: 14px;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    a { color: var(--accent-dark); text-decoration: none; }
    a:hover { color: var(--accent); }
    button { font-family: inherit; }

    .auth-bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
    .auth-bg span { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .75; }
    .auth-bg .g1 { width: 520px; height: 520px; background: var(--lavender); top: -180px; left: -140px; }
    .auth-bg .g2 { width: 460px; height: 460px; background: var(--blue); bottom: -200px; right: -120px; }
    .auth-bg .g3 { width: 300px; height: 300px; background: var(--mint); top: 40%; left: 55%; opacity: .5; }

    .page {
      min-height: 100vh; min-height: 100dvh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 32px 20px;
    }
    .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); margin-bottom: 24px; }
    .brand:hover { color: var(--text); }
    .brand-logo {
      width: 42px; height: 42px; border-radius: 13px;
      background: linear-gradient(135deg, #A99DF0 0%, var(--accent) 55%, #6F63C4 100%);
      display: grid; place-items: center; color: #fff; font-size: 19px;
      box-shadow: 0 6px 16px rgba(139, 127, 214, .35);
    }
    .brand-name { font-weight: 800; font-size: 22px; letter-spacing: -.4px; }
    .brand-name span { color: var(--accent); }

    .card-x {
      position: relative; width: 100%; max-width: 500px;
      background: var(--card); border-radius: 28px; box-shadow: var(--shadow-lg);
      padding: 40px 40px 30px; text-align: center; overflow: hidden;
      animation: cardIn .5s var(--ease);
    }
    .card-x::before {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 150px; pointer-events: none;
      background:
        radial-gradient(circle, rgba(255, 255, 255, .85) 1.4px, transparent 2px) 0 0 / 22px 22px,
        linear-gradient(180deg, #EFEBFC 0%, rgba(239, 235, 252, 0) 100%);
    }
    .card-x > * { position: relative; }
    @@keyframes cardIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

    .mail-ic { position: relative; width: 88px; height: 88px; margin: 0 auto 22px; }
    .mail-ic .circle {
      width: 100%; height: 100%; border-radius: 28px;
      background: linear-gradient(135deg, #B4AAF0, var(--accent) 60%, #6F63C4);
      display: grid; place-items: center; color: #fff; font-size: 38px;
      box-shadow: 0 14px 30px rgba(111, 99, 196, .35);
      animation: bob 3.2s ease-in-out infinite;
    }
    .mail-ic .badge-ic {
      position: absolute; right: -8px; bottom: -6px;
      width: 34px; height: 34px; border-radius: 50%; border: 4px solid #fff;
      background: var(--success-soft); color: #fff; display: grid; place-items: center; font-size: 15px;
      box-shadow: 0 6px 14px rgba(92, 192, 154, .35);
    }
    .mail-ic .dot { position: absolute; border-radius: 50%; animation: bob 3s ease-in-out infinite; }
    .mail-ic .d1 { width: 12px; height: 12px; background: var(--mint); left: -22px; top: 14px; }
    .mail-ic .d2 { width: 8px; height: 8px; background: #F5CFDC; right: -20px; top: 6px; animation-delay: .8s; }
    .mail-ic .d3 { width: 10px; height: 10px; background: var(--blue); left: -12px; bottom: 2px; animation-delay: 1.4s; }
    @@keyframes bob { 50% { transform: translateY(-6px); } }

    h1 { font-size: 25px; font-weight: 800; letter-spacing: -.6px; margin: 0 0 10px; }
    .sub { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0 auto 6px; max-width: 360px; }
    .sub b { color: var(--text); font-weight: 700; }
    .change { font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; }

    .otp {
      display: grid; grid-template-columns: repeat(3, 1fr) 18px repeat(3, 1fr); gap: 10px;
      align-items: center; max-width: 400px; margin: 28px auto 0;
    }
    .otp .sep { height: 3px; border-radius: 3px; background: #DCD8F0; }
    .otp input {
      width: 100%; aspect-ratio: .86; min-width: 0;
      border: 1.5px solid var(--border); border-radius: 14px; background: var(--bg);
      text-align: center; font-size: 26px; font-weight: 800; color: var(--text); font-family: inherit;
      caret-color: var(--accent); outline: none;
      transition: border-color .2s, background .2s, box-shadow .2s, transform .15s var(--ease);
    }
    .otp input:hover { border-color: #DEDBEE; }
    .otp input:focus { background: #fff; border-color: #BFB6EE; box-shadow: 0 0 0 4px rgba(139, 127, 214, .14); transform: translateY(-2px); }
    .otp input.filled { background: #fff; border-color: #CFC8F2; }
    .otp input:disabled { opacity: .55; cursor: not-allowed; }
    .otp.is-invalid input { border-color: #EFAFC3; background: #FFF8FA; }
    .otp.is-invalid input:focus { box-shadow: 0 0 0 4px rgba(224, 117, 151, .14); }
    .otp.is-valid input { border-color: #A9DEC7; background: #F7FCFA; color: var(--success); }
    .shake { animation: shake .4s var(--ease); }
    @@keyframes shake { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }

    .msg { min-height: 20px; margin: 12px 0 0; font-size: 12.5px; font-weight: 500; }
    .msg.err { color: var(--danger); }
    .msg.err::before { content: "\F33A"; font-family: "bootstrap-icons"; margin-right: 6px; }

    .btn-primary-x {
      width: 100%; max-width: 400px; height: 52px; margin: 22px auto 0; border: 0; border-radius: 14px;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      font-size: 15px; font-weight: 700; color: #fff;
      background: linear-gradient(135deg, #9C91E2 0%, var(--accent) 50%, var(--accent-dark) 100%);
      background-size: 160% 100%;
      box-shadow: 0 10px 24px rgba(139, 127, 214, .38);
      transition: transform .2s var(--ease), box-shadow .2s var(--ease), background-position .4s var(--ease), opacity .2s;
    }
    .btn-primary-x:hover:not(:disabled) { color: #fff; transform: translateY(-2px); background-position: 100% 0; box-shadow: 0 14px 30px rgba(139, 127, 214, .45); }
    .btn-primary-x:disabled { opacity: .55; cursor: not-allowed; box-shadow: none; }
    .btn-primary-x.loading { opacity: .9; cursor: wait; }
    .spinner-sm { width: 16px; height: 16px; border: 2px solid rgba(255, 255, 255, .35); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .resend { margin-top: 18px; font-size: 13.5px; color: #5D6075; }
    .resend button { border: 0; background: none; padding: 0; font-weight: 700; color: var(--accent-dark); }
    .resend button:hover:not(:disabled) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
    .resend button:disabled { color: var(--muted); cursor: default; font-weight: 600; }
    .resend .cd { font-variant-numeric: tabular-nums; }

    .tip {
      display: flex; align-items: flex-start; gap: 10px; text-align: left;
      margin: 22px auto 0; max-width: 400px; padding: 12px 14px; border-radius: 13px;
      background: var(--blue); color: #4A7CC2; font-size: 12.5px; line-height: 1.5;
    }
    .tip i { font-size: 15px; margin-top: 1px; }

    .card-foot { margin-top: 22px; padding-top: 18px; border-top: 1px dashed var(--border); font-size: 13px; }
    .card-foot a { font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }

    .success { animation: cardIn .45s var(--ease); }
    .success-ic { width: 92px; height: 92px; border-radius: 50%; margin: 6px auto 22px; background: var(--mint); display: grid; place-items: center; position: relative; }
    .success-ic::before { content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 2px dashed #BFE6D5; animation: spin 14s linear infinite; }
    .success-ic svg { width: 46px; height: 46px; }
    .success-ic path { stroke: var(--success); stroke-width: 3.2; fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw .6s .2s var(--ease) forwards; }
    @@keyframes draw { to { stroke-dashoffset: 0; } }
    .redirect-note { font-size: 12.5px; color: var(--muted); margin-top: 12px; }

    .page-foot { margin-top: 20px; font-size: 12px; color: var(--muted); text-align: center; }

    .toast-stack { position: fixed; top: 22px; left: 50%; transform: translateX(-50%); z-index: 3000; display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; width: max-content; max-width: calc(100vw - 24px); }
    .m-toast {
      pointer-events: auto; display: flex; align-items: center; gap: 12px;
      background: #2E3045; color: #fff; padding: 12px 18px 12px 14px; border-radius: 14px;
      box-shadow: 0 14px 34px rgba(46, 48, 69, .3); font-size: 13.5px; font-weight: 500;
      animation: toastIn .3s var(--ease);
    }
    .m-toast .ti { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: rgba(92, 192, 154, .2); color: #8FE0BE; flex-shrink: 0; }
    .m-toast.error .ti { background: rgba(224, 117, 151, .2); color: #F4A3BD; }
    .m-toast b { display: block; font-weight: 700; }
    .m-toast.out { animation: toastOut .25s var(--ease) forwards; }
    @@keyframes toastIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
    @@keyframes toastOut { to { opacity: 0; transform: translateY(-10px); } }

    @@media (max-width: 575.98px) {
      .page { padding: 20px 14px; justify-content: flex-start; }
      .brand { margin: 8px 0 18px; }
      .card-x { padding: 32px 20px 24px; border-radius: 24px; }
      h1 { font-size: 22px; }
      .sub { font-size: 14px; }
      .otp { gap: 7px; grid-template-columns: repeat(3, 1fr) 10px repeat(3, 1fr); }
      .otp input { font-size: 22px; border-radius: 12px; }
    }

    @@media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
