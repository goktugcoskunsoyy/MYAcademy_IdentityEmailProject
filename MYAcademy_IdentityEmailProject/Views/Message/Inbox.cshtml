@model List<Message>
@{
    ViewData["Title"] = "Gelen Kutusu";
    ViewData["ActiveMenu"] = "inbox";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var users = ViewBag.Users as List<AppUser> ?? new List<AppUser>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string? search = ViewBag.Search;
    int? categoryId = ViewBag.CategoryId;
    string? filter = ViewBag.Filter;
    string sort = ViewBag.Sort;
    bool hasFilter = !string.IsNullOrEmpty(search) || categoryId != null || !string.IsNullOrEmpty(filter);
}

<section class="inbox" id="inbox">

    <div class="panel list-panel">

        <div class="list-head">
            <div class="list-title">
                <div>
                    <h1>Gelen Kutusu</h1>
                    <div class="sub">@ViewBag.AllCount mesaj · @ViewBag.Email</div>
                </div>
                <span class="count-pill">@ViewBag.UnreadCount okunmamış</span>
            </div>

            <form class="list-tools" method="get" asp-action="Inbox">
                <div class="list-search @(string.IsNullOrEmpty(search) ? "" : "has-value")">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@search" placeholder="Gönderen, konu veya içerik ara" autocomplete="off">
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <a class="clear" asp-action="Inbox" asp-route-categoryId="@categoryId" asp-route-filter="@filter" asp-route-sort="@sort" aria-label="Temizle"><i class="bi bi-x-circle-fill"></i></a>
                    }
                </div>
                <div class="list-select">
                    <select name="categoryId" asp-items="ViewBag.Categories" onchange="this.form.submit()" aria-label="Kategori">
                        <option value="">Tüm kategoriler</option>
                    </select>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div class="list-select">
                    <select name="sort" onchange="this.form.submit()" aria-label="Sıralama">
                        <option value="newest" selected="@(sort == "newest")">En yeni önce</option>
                        <option value="oldest" selected="@(sort == "oldest")">En eski önce</option>
                    </select>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <input type="hidden" name="filter" value="@filter">
            </form>

            <div class="filter-chips">
                <a class="chip @(string.IsNullOrEmpty(filter) ? "active" : "")" asp-action="Inbox" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-sort="@sort">Tümü <span class="n">@ViewBag.AllCount</span></a>
                <a class="chip @(filter == "unread" ? "active" : "")" asp-action="Inbox" asp-route-filter="unread" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-sort="@sort">Okunmamış <span class="n">@ViewBag.UnreadCount</span></a>
                <a class="chip @(filter == "favorite" ? "active" : "")" asp-action="Inbox" asp-route-filter="favorite" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-sort="@sort">Yıldızlı <span class="n">@ViewBag.FavoriteCount</span></a>
                @if (hasFilter)
                {
                    <a class="chip" asp-action="Inbox"><i class="bi bi-x"></i> Filtreleri temizle</a>
                }
            </div>
        </div>

        <form id="bulkForm" method="post">
            <input type="hidden" name="returnUrl" value="@returnUrl">
        </form>

        <div class="bulk-bar">
            <input type="checkbox" class="m-check" id="checkAll" aria-label="Tümünü seç">
            <span class="sel-info" id="selInfo">Tümünü seç</span>
            <span class="spacer"></span>
            <button type="submit" form="bulkForm" formaction="@Url.Action("MarkAsRead", "Message")" class="tool-btn" data-bulk title="Okundu olarak işaretle" disabled><i class="bi bi-envelope-open"></i></button>
            <button type="submit" form="bulkForm" formaction="@Url.Action("MarkAsUnread", "Message")" class="tool-btn" data-bulk title="Okunmadı olarak işaretle" disabled><i class="bi bi-envelope"></i></button>
            <button type="submit" form="bulkForm" formaction="@Url.Action("MoveToTrash", "Message")" class="tool-btn" data-bulk title="Çöp kutusuna taşı" disabled><i class="bi bi-trash3"></i></button>
            <a href="@returnUrl" class="tool-btn" title="Yenile"><i class="bi bi-arrow-clockwise"></i></a>
        </div>

        <div class="msg-list" id="msgList">
            @foreach (var item in Model)
            {
                var sender = users.FirstOrDefault(x => x.Email == item.SenderEmail);
                var senderName = sender != null ? sender.Name + " " + sender.Surname : item.SenderEmail;

                <article class="msg-item @(item.IsRead ? "" : "unread")" data-href="@Url.Action("MessageDetail", "Message", new { id = item.MessageId })" tabindex="0" title="Mesajı aç">
                    <div class="lead">
                        <input type="checkbox" class="m-check row-check" name="ids" value="@item.MessageId" form="bulkForm" aria-label="Seç">
                        <button class="star-btn @(item.IsFavorite ? "on" : "")" type="submit" form="bulkForm" formaction="@Url.Action("ToggleFavorite", "Message", new { id = item.MessageId })" aria-label="Yıldızla" title="@(item.IsFavorite ? "Yıldızı kaldır" : "Yıldızla")">
                            <i class="bi @(item.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    </div>
                    <span class="avatar @MessageHelper.AvatarColor(item.SenderEmail)">
                        @if (sender != null && !string.IsNullOrEmpty(sender.ImageUrl))
                        {
                            <img src="@sender.ImageUrl" alt="@senderName">
                        }
                        else
                        {
                            @MessageHelper.Initials(senderName)
                        }
                    </span>
                    <div class="mi-sender">
                        <span class="sender" title="@item.SenderEmail">@senderName</span>
                        @if (!item.IsRead)
                        {
                            <span class="unread-dot"></span>
                        }
                    </div>
                    <div class="mi-main">
                        <span class="subject">@item.Subject</span>
                        <span class="snippet">@MessageHelper.Snippet(item.MessageDetail)</span>
                    </div>
                    <div class="mi-meta">
                        @if (item.Category != null)
                        {
                            <span class="tag" style="@MessageHelper.CategoryStyle(item.CategoryId)">@item.Category.CategoryName</span>
                        }
                    </div>
                    <span class="time" title="@MessageHelper.LongTime(item.SendDate)">@MessageHelper.ShortTime(item.SendDate)</span>
                </article>
            }

            @if (!Model.Any())
            {
                if (hasFilter)
                {
                    <div class="empty-list">
                        <div class="ic"><i class="bi bi-search-heart"></i></div>
                        <h6>Sonuç bulunamadı</h6>
                        <div>Arama veya filtre kriterlerini değiştirmeyi deneyin.</div>
                    </div>
                }
                else
                {
                    <div class="empty-list">
                        <div class="ic"><i class="bi bi-inbox"></i></div>
                        <h6>Gelen kutunuz boş</h6>
                        <div>Yeni mesajlar geldiğinde burada listelenecek.</div>
                    </div>
                }
            }
        </div>

        <div class="list-foot">
            <span class="range" id="rangeInfo"></span>
            <div class="pager" id="pager"></div>
        </div>
    </div>

</section>
