@model List<Message>
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveMenu"] = "dashboard";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var users = ViewBag.Users as List<AppUser> ?? new List<AppUser>();
    var lastSendboxMessages = ViewBag.LastSendboxMessages as List<Message> ?? new List<Message>();
    List<int?> categoryIds = ViewBag.CategoryIds;
    List<string> categoryNames = ViewBag.CategoryNames;
    List<int> categoryCounts = ViewBag.CategoryCounts;
    List<string> dayLabels = ViewBag.DayLabels;
    List<int> inboxDailyCounts = ViewBag.InboxDailyCounts;
    List<int> sendboxDailyCounts = ViewBag.SendboxDailyCounts;
    var categoryColors = categoryIds.Select(x => MessageHelper.CategoryColor(x)).ToList();
    int categoryTotal = categoryCounts.Sum();

    int inboxCount = ViewBag.InboxCount;
    int sendboxCount = ViewBag.SendboxCount;
    int unreadCount = ViewBag.UnreadCount;
    int favoriteCount = ViewBag.FavoriteCount;
    int favoriteUnreadCount = ViewBag.FavoriteUnreadCount;
    int draftCount = ViewBag.DraftCount;
    int trashCount = ViewBag.TrashCount;
    int todayCount = ViewBag.TodayCount;
    int weekSendboxCount = ViewBag.WeekSendboxCount;
    int readPercent = inboxCount == 0 ? 0 : (inboxCount - unreadCount) * 100 / inboxCount;

    var tr = new System.Globalization.CultureInfo("tr-TR");
    var hour = DateTime.Now.Hour;
    var greeting = hour < 5 ? "İyi geceler" : hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : hour < 22 ? "İyi akşamlar" : "İyi geceler";
}

<style>
    a.db-stat, a.db-tile, a.db-msg, a.db-chip {
        color: inherit;
        text-decoration: none;
    }

    .db-traffic {
        display: flex;
        flex-direction: column;
    }

        .db-traffic .db-chart-box {
            flex: 1 1 290px;
            height: auto;
            min-height: 290px;
        }

    @@media (min-width: 1200px) {
        .db-stats {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }
</style>

<section class="dashboard" id="dashboard">

    <div class="db-welcome">
        <div class="db-welcome-text">
            <span class="db-date"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("d MMMM yyyy, dddd", tr)</span>
            <h1>@greeting, <span>@ViewBag.Name</span>! <span class="wave">👋</span></h1>
            <p>E-posta hesabında bugün neler olduğunu birlikte inceleyelim.</p>
            <div class="db-welcome-row">
                <a class="btn-send" asp-controller="Message" asp-action="CreateMessage"><span class="lbl"><i class="bi bi-pencil-square"></i> Yeni Mesaj Oluştur</span></a>
                <span class="db-chip"><i class="bi bi-envelope-arrow-down"></i> Bugün <b>@todayCount</b> yeni mesaj</span>
                @if (unreadCount > 0)
                {
                    <a class="db-chip warn" asp-controller="Message" asp-action="Inbox" asp-route-filter="unread"><i class="bi bi-exclamation-circle"></i> <b>@unreadCount</b> okunmamış mesaj bekliyor</a>
                }
                else
                {
                    <span class="db-chip ok"><i class="bi bi-check2-circle"></i> Tüm mesajlar okundu</span>
                }
            </div>
        </div>
        <div class="db-illus" aria-hidden="true">
            <span class="plane"><i class="bi bi-send-fill"></i></span>
            <span class="bubble b1"></span><span class="bubble b2"></span><span class="bubble b3"></span>
            <div class="env">
                <div class="letter"><i></i><i></i><i></i></div>
                <div class="env-front"></div>
                @if (unreadCount > 0)
                {
                    <span class="env-badge">@unreadCount</span>
                }
            </div>
        </div>
    </div>

    <div class="db-stats">
        <a class="db-stat t-blue" asp-controller="Message" asp-action="Inbox">
            <div class="top"><span class="ic"><i class="bi bi-inbox-fill"></i></span><span class="trend">Bugün +@todayCount</span></div>
            <div class="num">@inboxCount.ToString("N0", tr)</div>
            <div class="lbl">Gelen Mesajlar</div>
            <div class="desc"><span>Gelen kutunuzdaki mesajlar</span><i class="bi bi-arrow-right"></i></div>
        </a>
        <a class="db-stat t-lav" asp-controller="Message" asp-action="Sendbox">
            <div class="top"><span class="ic"><i class="bi bi-send-fill"></i></span><span class="trend">7 gün: @weekSendboxCount</span></div>
            <div class="num">@sendboxCount.ToString("N0", tr)</div>
            <div class="lbl">Gönderilen Mesajlar</div>
            <div class="desc"><span>Bu hafta @weekSendboxCount mesaj</span><i class="bi bi-arrow-right"></i></div>
        </a>
        <a class="db-stat t-mint" asp-controller="Message" asp-action="Inbox" asp-route-filter="unread">
            <div class="top"><span class="ic"><i class="bi bi-envelope-fill"></i></span><span class="trend">Kutunun %@(inboxCount == 0 ? 0 : unreadCount * 100 / inboxCount)'i</span></div>
            <div class="num">@unreadCount.ToString("N0", tr)</div>
            <div class="lbl">Okunmamış Mesajlar</div>
            <div class="desc"><span>Gelen kutunuzda bekliyor</span><i class="bi bi-arrow-right"></i></div>
        </a>
        <a class="db-stat t-peach" asp-controller="Message" asp-action="Favorites">
            <div class="top"><span class="ic"><i class="bi bi-star-fill"></i></span><span class="trend">Önemli</span></div>
            <div class="num">@favoriteCount.ToString("N0", tr)</div>
            <div class="lbl">Yıldızlı Mesajlar</div>
            <div class="desc"><span>@(favoriteUnreadCount > 0 ? favoriteUnreadCount + " tanesi henüz okunmadı" : "Tamamı okundu")</span><i class="bi bi-arrow-right"></i></div>
        </a>
        <a class="db-stat t-lav" asp-controller="Message" asp-action="Drafts">
            <div class="top"><span class="ic"><i class="bi bi-file-earmark-text-fill"></i></span><span class="trend">Taslak</span></div>
            <div class="num">@draftCount.ToString("N0", tr)</div>
            <div class="lbl">Taslak Mesajlar</div>
            <div class="desc"><span>Gönderilmeyi bekliyor</span><i class="bi bi-arrow-right"></i></div>
        </a>
    </div>

    <div class="db-row charts">
        <div class="db-card db-traffic">
            <div class="db-card-head">
                <div>
                    <h3>Mesaj Trafiği</h3>
                    <p>Gelen ve gönderilen mesajlarınızın günlere göre dağılımı.</p>
                </div>
                <div class="db-seg" role="tablist" aria-label="Zaman aralığı">
                    <button type="button" role="tab" data-range="7" class="active" aria-selected="true">Son 7 Gün</button>
                    <button type="button" role="tab" data-range="30" aria-selected="false">Son 30 Gün</button>
                </div>
            </div>
            <div class="db-legend">
                <button type="button" class="db-legend-item" data-ds="0"><span class="sw" style="background:#8B7FD6"></span>Gelen Mesajlar <b id="dbLegInc">0</b></button>
                <button type="button" class="db-legend-item" data-ds="1"><span class="sw" style="background:#6FA8E8"></span>Gönderilen Mesajlar <b id="dbLegSent">0</b></button>
            </div>
            <div class="db-chart-box"><canvas id="dbTraffic" aria-label="Mesaj trafiği grafiği" role="img"></canvas></div>
        </div>

        <div class="db-card db-dist">
            <div class="db-card-head">
                <div><h3>Kategori Dağılımı</h3><p>Gelen ve gönderilen mesajlarınızın kategorilere göre dağılımı</p></div>
            </div>
            <div class="db-dist-body">
                <div class="db-donut-box">
                    <canvas id="dbDonut" aria-label="Kategori dağılımı grafiği" role="img"></canvas>
                    <div class="db-donut-center"><div><b>@categoryTotal</b><span>Toplam mesaj</span></div></div>
                </div>
                <ul class="db-dist-list">
                    @for (int i = 0; i < categoryNames.Count; i++)
                    {
                        <li>
                            <span class="db-dot" style="background:@categoryColors[i]"></span>@categoryNames[i]
                            <span class="c">@categoryCounts[i]</span><span class="p">%@(categoryTotal == 0 ? 0 : categoryCounts[i] * 100 / categoryTotal)</span>
                        </li>
                    }
                    @if (!categoryNames.Any())
                    {
                        <li>Henüz mesaj bulunmuyor.</li>
                    }
                </ul>
            </div>
            <div class="db-starred-note">
                <i class="bi bi-star-fill"></i>
                <span><b>@favoriteCount</b> @(favoriteUnreadCount > 0 ? "yıldızlı mesaj · " + favoriteUnreadCount + " tanesi okunmamış" : "yıldızlı mesaj")</span>
                <a class="link-btn" asp-controller="Message" asp-action="Favorites">Görüntüle</a>
            </div>
        </div>
    </div>

    <div class="db-row bottom">

        <div class="db-card db-recent">
            <div class="db-card-head">
                <div><h3>Son Gelen Mesajlar</h3><p>Gelen kutunuzdaki en yeni 5 mesaj</p></div>
                <a class="db-link" asp-controller="Message" asp-action="Inbox">Tümünü Gör <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="db-msgs">
                @foreach (var item in Model)
                {
                    var sender = users.FirstOrDefault(x => x.Email == item.SenderEmail);
                    var senderName = sender != null ? sender.Name + " " + sender.Surname : item.SenderEmail;

                    <a class="db-msg @(item.IsRead ? "" : "unread")" asp-controller="Message" asp-action="MessageDetail" asp-route-id="@item.MessageId">
                        <span class="avatar @MessageHelper.AvatarColor(item.SenderEmail)">
                            @if (sender != null && !string.IsNullOrEmpty(sender.ImageUrl))
                            {
                                <img src="@sender.ImageUrl" alt="@senderName">
                            }
                            else
                            {
                                @MessageHelper.Initials(senderName)
                            }
                        </span>
                        <span class="bd">
                            <span class="nm">
                                @senderName
                                @if (!item.IsRead)
                                {
                                    <span class="unread-dot" title="Okunmamış"></span>
                                }
                            </span>
                            <span class="sj d-block">@item.Subject</span>
                            <span class="sn d-block">@MessageHelper.Snippet(item.MessageDetail, 90)</span>
                        </span>
                        <span class="tm">@MessageHelper.ShortTime(item.SendDate)</span>
                    </a>
                }
                @if (!Model.Any())
                {
                    <div class="empty-list"><h6>Gelen kutunuz boş</h6></div>
                }
            </div>
        </div>

        <div class="db-card db-recent">
            <div class="db-card-head">
                <div><h3>Son Gönderilen Mesajlar</h3><p>Gönderdiğiniz en yeni 5 mesaj</p></div>
                <a class="db-link" asp-controller="Message" asp-action="Sendbox">Tümünü Gör <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="db-msgs">
                @foreach (var item in lastSendboxMessages)
                {
                    var receiver = users.FirstOrDefault(x => x.Email == item.ReceiverEmail);
                    var receiverName = receiver != null ? receiver.Name + " " + receiver.Surname : item.ReceiverEmail;

                    <a class="db-msg" asp-controller="Message" asp-action="MessageDetail" asp-route-id="@item.MessageId">
                        <span class="avatar @MessageHelper.AvatarColor(item.ReceiverEmail)">
                            @if (receiver != null && !string.IsNullOrEmpty(receiver.ImageUrl))
                            {
                                <img src="@receiver.ImageUrl" alt="@receiverName">
                            }
                            else
                            {
                                @MessageHelper.Initials(receiverName)
                            }
                        </span>
                        <span class="bd">
                            <span class="nm">@receiverName</span>
                            <span class="sj d-block">@item.Subject</span>
                            <span class="sn d-block">@MessageHelper.Snippet(item.MessageDetail, 90)</span>
                        </span>
                        <span class="tm">@MessageHelper.ShortTime(item.SendDate)</span>
                    </a>
                }
                @if (!lastSendboxMessages.Any())
                {
                    <div class="empty-list"><h6>Henüz mesaj göndermediniz</h6></div>
                }
            </div>
        </div>

        <div class="db-side">
            <div class="db-card">
                <div class="db-card-head"><div><h3>Hızlı İşlemler</h3></div></div>
                <div class="db-quick-grid">
                    <a class="db-tile t-lav" asp-controller="Message" asp-action="CreateMessage"><i class="bi bi-pencil-square"></i><span>Yeni Mesaj<small>Mesaj oluştur</small></span></a>
                    <a class="db-tile t-blue" asp-controller="Message" asp-action="Inbox"><i class="bi bi-inbox"></i><span>Gelen Kutusu<small>@unreadCount okunmamış</small></span></a>
                    <a class="db-tile t-mint" asp-controller="Message" asp-action="Drafts"><i class="bi bi-file-earmark-text"></i><span>Taslaklar<small>@draftCount taslak</small></span></a>
                    <a class="db-tile t-peach" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-gear"></i><span>Profilim<small>Bilgileri düzenle</small></span></a>
                </div>
            </div>

            <div class="db-card">
                <div class="db-card-head"><div><h3>Hesap Özeti</h3></div></div>
                <ul class="pf-list">
                    <li><span class="k"><i class="bi bi-envelope-check"></i> Okunma oranı</span><span class="v">%@readPercent</span></li>
                    <li><span class="k"><i class="bi bi-send-check"></i> Bu hafta gönderilen</span><span class="v">@weekSendboxCount mesaj</span></li>
                    <li><span class="k"><i class="bi bi-trash3"></i> Çöp kutusu</span><span class="v">@trashCount mesaj</span></li>
                    <li><span class="k"><i class="bi bi-shield-check"></i> Hesap durumu</span><span class="v"><span class="pf-badge ok">Doğrulandı</span></span></li>
                </ul>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script>
        (() => {
            const { $, $$ } = window.Mailora;

            const DAY_LABELS = @Json.Serialize(dayLabels);
            const INBOX_DAILY = @Json.Serialize(inboxDailyCounts);
            const SENDBOX_DAILY = @Json.Serialize(sendboxDailyCounts);
            const CATEGORY_NAMES = @Json.Serialize(categoryNames);
            const CATEGORY_COUNTS = @Json.Serialize(categoryCounts);
            const CATEGORY_COLORS = @Json.Serialize(categoryColors);

            let range = 7;
            let trafficChart = null;

            const sum = list => list.reduce((a, b) => a + b, 0);
            const getTraffic = r => ({
                labels: DAY_LABELS.slice(-r),
                inc: INBOX_DAILY.slice(-r),
                sent: SENDBOX_DAILY.slice(-r)
            });

            function updateLegend(t) {
                $('#dbLegInc').textContent = sum(t.inc).toLocaleString('tr-TR');
                $('#dbLegSent').textContent = sum(t.sent).toLocaleString('tr-TR');
            }

            function chartFallback(canvas) {
                if (canvas && canvas.parentElement)
                    canvas.parentElement.innerHTML = '<div class="db-chart-empty"><div><i class="bi bi-graph-up"></i>Grafik kütüphanesi yüklenemedi.<br>İnternet bağlantınızı kontrol edin.</div></div>';
            }

            const tooltip = {
                backgroundColor: '#2E3045', titleColor: '#fff', bodyColor: '#E4E1F5',
                padding: 12, cornerRadius: 10, boxPadding: 5, usePointStyle: true,
                titleFont: { weight: '700', size: 12.5 }, bodyFont: { size: 12.5 }
            };

            const softFill = hex => ctx => {
                const { chart } = ctx, { ctx: g, chartArea } = chart;
                if (!chartArea) return 'transparent';
                const gr = g.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                gr.addColorStop(0, hex + '40');
                gr.addColorStop(1, hex + '00');
                return gr;
            };

            function buildCharts() {
                const tCanvas = $('#dbTraffic'), dCanvas = $('#dbDonut');
                const t = getTraffic(range);
                updateLegend(t);
                if (typeof Chart === 'undefined') { chartFallback(tCanvas); chartFallback(dCanvas); return; }

                Chart.defaults.font.family = "'Plus Jakarta Sans', system-ui, sans-serif";
                Chart.defaults.color = '#85899B';

                const line = (label, data, color) => ({
                    label, data, borderColor: color, backgroundColor: softFill(color), fill: true, tension: .4, borderWidth: 2.5,
                    pointRadius: range === 7 ? 4 : 0, pointHoverRadius: 6,
                    pointBackgroundColor: '#fff', pointBorderColor: color, pointBorderWidth: 2,
                    pointHoverBackgroundColor: color, pointHoverBorderColor: '#fff'
                });

                trafficChart = new Chart(tCanvas, {
                    type: 'line',
                    data: { labels: t.labels, datasets: [line('Gelen Mesajlar', t.inc, '#8B7FD6'), line('Gönderilen Mesajlar', t.sent, '#6FA8E8')] },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: { legend: { display: false }, tooltip: { ...tooltip, callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y}` } } },
                        scales: {
                            x: { grid: { display: false }, border: { display: false }, ticks: { color: '#A6A9B8', maxRotation: 0, autoSkip: true, maxTicksLimit: 8, font: { size: 11.5 } } },
                            y: { beginAtZero: true, grid: { color: '#F1F0F8' }, border: { display: false }, ticks: { color: '#A6A9B8', padding: 10, maxTicksLimit: 5, precision: 0, font: { size: 11.5 } } }
                        }
                    }
                });

                const total = sum(CATEGORY_COUNTS);
                new Chart(dCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: CATEGORY_NAMES.length ? CATEGORY_NAMES : ['Mesaj yok'],
                        datasets: [{
                            data: CATEGORY_COUNTS.length ? CATEGORY_COUNTS : [1],
                            backgroundColor: CATEGORY_COLORS.length ? CATEGORY_COLORS : ['#ECEBF5'],
                            borderWidth: 0, borderRadius: 6, spacing: 3, hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: '74%',
                        plugins: {
                            legend: { display: false },
                            tooltip: { ...tooltip, enabled: total > 0, callbacks: { label: c => ` ${c.label}: ${c.parsed} (%${Math.round(c.parsed / Math.max(total, 1) * 100)})` } }
                        }
                    }
                });
            }

            $$('[data-range]').forEach(b => b.addEventListener('click', () => {
                range = +b.dataset.range;
                $$('[data-range]').forEach(x => { const on = x === b; x.classList.toggle('active', on); x.setAttribute('aria-selected', on); });
                const t = getTraffic(range);
                updateLegend(t);
                if (!trafficChart) return;
                trafficChart.data.labels = t.labels;
                trafficChart.data.datasets[0].data = t.inc;
                trafficChart.data.datasets[1].data = t.sent;
                trafficChart.data.datasets.forEach(ds => { ds.pointRadius = range === 7 ? 4 : 0; });
                trafficChart.update();
            }));

            $$('[data-ds]').forEach(b => b.addEventListener('click', () => {
                if (!trafficChart) return;
                const i = +b.dataset.ds, visible = trafficChart.isDatasetVisible(i);
                trafficChart.setDatasetVisibility(i, !visible);
                b.classList.toggle('off', visible);
                trafficChart.update();
            }));

            buildCharts();
        })();
    </script>
}
